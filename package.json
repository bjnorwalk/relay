{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @relay/web dev",
    "build": "pnpm --recursive --if-present build",
    "start": "pnpm --filter @relay/web start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9"
  }
}
